# ─────────────────────────────────────────────────────────────────────────────
# Refilwe Molapisi — Analytics Portfolio · environment variables
# Copy to .env for local development (Prisma CLI reads .env, and Next.js
# reads it too), and set the same values in Vercel → Project → Settings →
# Environment Variables for production.
# NEVER commit real credentials (.env is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site URL ──────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap.xml and robots.txt.
# Local: http://localhost:3000 · Production: your final domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Prisma + SQLite) ────────────────────────────────────────────────
# SQLite: a single file, no external service needed. Relative paths resolve
# against prisma/schema.prisma during development (so "file:./dev.db" lives at
# prisma/dev.db).
DATABASE_URL=file:./dev.db

# For production builds (next build + standalone server) use an ABSOLUTE path —
# the running server resolves relative paths from its own working directory:
#   DATABASE_URL=file:/absolute/path/to/data/portfolio.db
#
# On read-only/ephemeral hosts (e.g. Vercel), point the file at /tmp:
#   DATABASE_URL=file:/tmp/portfolio.db
# NOTE: SQLite data does not persist across serverless deploys/instances.
# For durable hosted data, flip `provider` in prisma/schema.prisma to
# "postgresql" (or "mysql") and point DATABASE_URL at any managed database —
# the models themselves are portable.

# ── Media uploads (disk) ─────────────────────────────────────────────────────
# Directory where admin-uploaded media files are stored.
# Defaults to ./uploads next to the app; override for persistent volumes.
# UPLOAD_DIR=/data/uploads

# ── Admin panel ──────────────────────────────────────────────────────────────
# Credentials for /admin/login. Choose a strong password before deploying.
ADMIN_EMAIL=admin@refilwemolapisi.co.za
ADMIN_PASSWORD=change-me-before-deploying
# Secret used to sign admin session cookies — generate with:
#   openssl rand -base64 32
AUTH_SECRET=
