# ─────────────────────────────────────────────────────────────────────────────
# Refilwe Molapisi — Analytics Portfolio · environment variables
# Copy to .env.local for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real credentials (.env.local is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site URL ──────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap.xml and robots.txt.
# Local: http://localhost:3000 · Production: your final domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase Postgres (via Prisma) ───────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI
# Runtime queries go through the connection pooler (pgBouncer, port 6543).
# Use the "Transaction" pooler string and keep connection_limit low for
# serverless platforms like Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations / introspection need a direct (session) connection, port 5432.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Supabase Storage (media uploads) ─────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Server-only. Uploads and admin operations. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Bucket created by supabase/migrations/0003_storage.sql
SUPABASE_MEDIA_BUCKET=media

# ── Admin panel ──────────────────────────────────────────────────────────────
# Credentials for /admin/login. Choose a strong password before deploying.
ADMIN_EMAIL=admin@refilwemolapisi.co.za
ADMIN_PASSWORD=change-me-before-deploying
# Secret used to sign admin session cookies — generate with:
#   openssl rand -base64 32
AUTH_SECRET=
